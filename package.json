{
  "name": "shopping-basket-fullstack",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["server", "client"],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "start:server": "npm start -w server",
    "start:client": "npm run dev -w client",
    "test": "npm test -w server && npm test -w client",
    "test:server": "npm test -w server",
    "test:client": "npm test -w client",
    "build": "npm run build -w client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
